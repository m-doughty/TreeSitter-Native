    ; Query
    tsn_query_new
    tsn_query_delete
    tsn_query_pattern_count
    tsn_query_capture_count
    tsn_query_string_count
    tsn_query_capture_name_for_id
    tsn_query_string_value_for_id
    tsn_query_predicate_step_count
    tsn_query_predicate_step
    tsn_query_start_byte_for_pattern

    ; Query cursor and matches
    tsn_query_cursor_new
    tsn_query_cursor_delete
